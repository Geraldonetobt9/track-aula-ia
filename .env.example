# ============================================================
# Modelo de variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha. O .env.local está no
# .gitignore e NUNCA deve ser commitado.
#
#   cp .env.example .env.local
#
# Regra de ouro: tudo que começa com VITE_ é embutido no bundle do navegador e
# é PÚBLICO. Qualquer pessoa que abrir o site consegue ler. O resto só existe no
# servidor (funções da Vercel) e nunca chega ao browser.

# ------------------------------------------------------------
# Supabase — lado do servidor (SECRETO)
# ------------------------------------------------------------
# Painel do Supabase > Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Ignora RLS por completo. Se vazar, a base inteira vaza.
# Só use em código que roda no servidor. NUNCA com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > API > JWT Settings. Usado para validar o token do usuário.
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------
# Supabase — lado do navegador (público, protegido por RLS)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Criptografia
# ------------------------------------------------------------
# 32 bytes em hex. Cifra o token do Meta e os tokens de API dos checkouts
# em repouso no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar esta chave torna ilegível tudo que já foi cifrado com ela.
ENCRYPTION_KEY=

# ------------------------------------------------------------
# Meta Ads
# ------------------------------------------------------------
# Não há FACEBOOK_APP_ID nem FACEBOOK_APP_SECRET: a conexão é o cliente colar o
# access token na tela de Integrações, e o sistema descobrir as contas de
# anúncio sozinho a partir dele.
META_API_VERSION=v22.0

# ------------------------------------------------------------
# Opcionais
# ------------------------------------------------------------
# Inferência de gênero a partir do nome, nos relatórios de público.
GENDERIZE_API_KEY=

# URL pública do app. Em desenvolvimento, o Vite local.
APP_URL=http://localhost:5173

# ------------------------------------------------------------
# Quem pode entrar
# ------------------------------------------------------------
# Não é configurado aqui. A lista de usuários permitidos vive na tabela
# app_users, e cada conta é criada pelo admin em
# Authentication > Users > Add user, no painel do Supabase.
