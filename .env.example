# ============================================================
# Variáveis de ambiente
# ============================================================
# Na Vercel: Settings → Environment Variables (cole o bloco de uma vez).
# Para rodar na sua máquina: copie este arquivo para .env.local e preencha.
# O .env.local está no .gitignore e NUNCA vai para o GitHub.

# ------------------------------------------------------------
# OBRIGATÓRIAS — as quatro saem do painel do Supabase
# ------------------------------------------------------------
# Supabase → Project Settings → API (ou Data API) → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → aba "Legacy API Keys" → anon / public
# Pública por natureza: vai para o navegador, protegida pelas regras do banco.
SUPABASE_ANON_KEY=

# Mesma tela → service_role (clique em "Reveal")
# SECRETA: dá acesso total ao banco. Só no servidor; nunca com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Seu e-mail (o mesmo do usuário criado no Supabase). Quem estiver aqui pode
# criar outros usuários em Configurações → Usuários. Vários: separe por vírgula.
ADMIN_EMAILS=voce@seudominio.com.br

# ------------------------------------------------------------
# OPCIONAIS — o painel funciona sem elas
# ------------------------------------------------------------
# Reenvio automático, uma vez por dia, dos eventos que o Meta recusou.
# Sem ela, o reenvio é pelo botão em Integrações. Qualquer texto longo e
# aleatório serve; para gerar um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Chave que cifra os tokens (Meta, checkouts) guardados no banco. Sem ela, a
# chave é derivada da SUPABASE_SERVICE_ROLE_KEY. Defina desde o início se
# pretende trocar a service role algum dia: trocar a chave depois obriga a
# colar os tokens de novo em Integrações. Gere como o CRON_SECRET.
ENCRYPTION_KEY=

# Versão da Graph API do Meta (Ads e API de Conversões). Padrão: v25.0.
# Só preencha para usar outra versão.
META_API_VERSION=
